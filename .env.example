SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MONDAY_API_TOKEN=
MONDAY_AGENTS_BOARD_ID=1593085910
# Board ids the deal/property wizards' Monday pickers read from (Phase 8/9) —
# not written to except via the sync bridges below.
MONDAY_PROPERTIES_BOARD_ID=1633691694
MONDAY_DEALS_BOARD_ID=1946512255
# Referrals board — outbound mirror only (Phase 9), no inbound sync: the app
# is the sole place referrals get created now; this is a write-only target
# so staff still looking at Monday see referrals during the transition.
MONDAY_REFERRALS_BOARD_ID=5092845827
# Daf Kesher <-> agents sync bridge (Phase 4d), and the same-shaped
# properties bridge (Phase 9). SYNC_SECRET guards POST /api/sync/agents and
# POST /api/sync/properties (both cron-triggered). MONDAY_SYNC_ENABLED=false
# turns OFF the app -> Monday mirror writes for both (inbound sync stays on).
SYNC_SECRET=
MONDAY_SYNC_ENABLED=true
META_WABA_PHONE_ID=
META_WABA_TOKEN=
META_WABA_TEMPLATE_NAME=
META_WABA_TEMPLATE_LANG=he
MAKE_OTP_WEBHOOK_URL=
DEV_OTP_BYPASS_CODE=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_EMAIL=
GREEN_INVOICE_ENV=sandbox
GREEN_INVOICE_CLIENT_ID=
GREEN_INVOICE_CLIENT_SECRET=
# Webhook secret set in the Green Invoice UI — verified on the inbound
# /api/green-invoice/webhook call (Phase 6).
GREEN_INVOICE_WEBHOOK_SECRET=

# Phase 8c — AI extraction on the deal wizard's document-upload step.
ANTHROPIC_API_KEY=

# Phase 9 — property wizard: address autocomplete (Places API New) + photo/
# document storage (Google Drive, a dedicated Shared Drive today — see
# ROADMAP.md Phase 9a for why domain-wide delegation was parked).
GOOGLE_MAPS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_PROPERTIES_ROOT_FOLDER_ID=
GOOGLE_DRIVE_IMPERSONATE_EMAIL=

# Phase 9 — property edit notifications. Any edit notifies the secretary
# (email/WhatsApp), each independently killable — set to "false" to disable
# just that channel. WhatsApp additionally needs a Meta-approved template
# before it can actually send.
SECRETARY_PHONE=
SECRETARY_EMAIL=
MAKE_NOTIFICATION_WEBHOOK_URL=
META_WABA_PROPERTY_UPDATE_TEMPLATE_NAME=
PROPERTY_NOTIFY_EMAIL_ENABLED=true
PROPERTY_NOTIFY_WHATSAPP_ENABLED=true

# Phase 9 — referral handoffs (/referrals/new, /r/[id]). Replaces the Monday
# "Referrals" board + its Make.com scenarios. NEXT_PUBLIC_APP_URL builds the
# absolute /r/[id] link sent in the invite WhatsApp message. BROKER_PHONE/
# BROKER_EMAIL get a ping on every new referral (creation only, for now) —
# no broker role exists in the app, this is a single office-wide contact
# like SECRETARY_PHONE/EMAIL above; email works with no Meta dependency.
#
# All three templates below already exist and are Meta-approved — just
# point these at their real names. outgoing_referral_update_agent_on_acceptance
# now covers accepted/declined/expired all in one (its {{status}} variable
# carries the Hebrew verb phrase — see sendReferralStatusTemplate in
# src/lib/waba/client.ts) — there's no separate "declined" template. The
# 25% fee text stays on the /r/[id] consent page only
# (src/lib/referral-consent.ts), deliberately not duplicated into any
# template body. No reject button on the invite template (Levi: a 48h
# response window that auto-declines is simpler than a second button — see
# src/lib/services/referral-expiry.ts). META_WABA_BROKER_REFERRAL_TEMPLATE_NAME
# is the one still genuinely new — nothing in the old Monday/Make flow ever
# notified a broker over WhatsApp (only a native Monday automation) — until
# that template exists and is approved, the broker still gets email.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BROKER_PHONE=
BROKER_EMAIL=
META_WABA_REFERRAL_INVITE_TEMPLATE_NAME=outgoing_referrals_approval
META_WABA_REFERRAL_DETAILS_TEMPLATE_NAME=outgoing_referral_details
META_WABA_REFERRAL_ACCEPTED_TEMPLATE_NAME=outgoing_referral_update_agent_on_acceptance
META_WABA_BROKER_REFERRAL_TEMPLATE_NAME=

# Meta WhatsApp status-callback webhook (debugging only — see
# src/app/api/webhooks/whatsapp/route.ts's doc comment for the Meta
# Business Manager setup steps and why this exists: our own "sent" status
# only means Meta's send API returned 200, never confirmed delivery).
# META_APP_SECRET is the Meta App's own secret (App Dashboard → Settings →
# Basic), used to verify the webhook's signature — a real secret, get it
# yourself, don't paste it into chat. META_WEBHOOK_VERIFY_TOKEN is just an
# arbitrary string you invent and enter in both places (here and Meta's
# webhook config UI) to prove the subscription request is really yours.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# AWS — local dev only. On Amplify these come from the compute role
# (grant it DynamoDB + S3), and AWS_REGION is set by the runtime.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DYNAMO_REGION= # only if the tables are in a different region than the app

DYNAMODB_TABLE_DEALS=agent-ledger-deals
DYNAMODB_TABLE_BILLING=agent-ledger-billing
DYNAMODB_TABLE_INCOME=agent-ledger-income
DYNAMODB_TABLE_AGENT_ACCOUNT=agent-ledger-agent-account
DYNAMODB_TABLE_GI_DOCUMENTS=agent-ledger-gi-documents
DYNAMODB_TABLE_RECURRING_EXPENSES=agent-ledger-recurring-expenses
DYNAMODB_TABLE_OFFICE_EXPENSES=agent-ledger-office-expenses
DYNAMODB_TABLE_BANK_TRANSACTIONS=agent-ledger-bank-transactions
DYNAMODB_TABLE_BANK_BALANCES=agent-ledger-bank-balances
DYNAMODB_TABLE_REMAX_ISRAEL_RECEIPTS=agent-ledger-remax-israel-receipts
DYNAMODB_TABLE_PROPERTIES=agent-ledger-properties
DYNAMODB_TABLE_REFERRALS=agent-ledger-referrals

DYNAMODB_TABLE_AGENTS=agent-ledger-agents
S3_ATTACHMENTS_BUCKET=agent-ledger-attachments
